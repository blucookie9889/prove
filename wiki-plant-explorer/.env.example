# Copy to .env (git-ignored) and paste your free keys; restart the backend afterwards.
# Unsplash: https://unsplash.com/oauth/applications -> New Application -> "Access Key"
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/ -> "Get started" / "Your API key"
PEXELS_API_KEY=
# The curator that looks at each picture and opens doors from it.
# Best free option: Gemini with a free Google AI Studio key (used first when set).
# https://aistudio.google.com/apikey -> "Create API key". Free tier: Google may use requests to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# How long Gemini thinks: medium (~30 s, richest doors, default) or low (~9 s, more obvious doors)
# GEMINI_THINKING=medium
# Free and local, nothing leaves the Mac (slower, weaker):
#   brew install ollama && ollama serve && ollama pull qwen3-vl:8b-instruct
# Optional overrides for the local model:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-vl:8b-instruct
# Paid alternative, used only without Gemini and Ollama:
# https://platform.claude.com/settings/keys -> "Create Key"
ANTHROPIC_API_KEY=
