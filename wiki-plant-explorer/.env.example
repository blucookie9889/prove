# Copy to .env (git-ignored) and paste your free keys; restart the backend afterwards.
# Unsplash: https://unsplash.com/oauth/applications -> New Application -> "Access Key"
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/ -> "Get started" / "Your API key"
PEXELS_API_KEY=
# The curator that looks at each picture and opens doors from it. Default: local, free, nothing
# leaves the Mac (Ollama):
#   brew install ollama && ollama serve && ollama pull gemma4:26b-a4b
# Faster on a Mac with Low Power Mode off (System Settings > Battery).
# CURATOR=local
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:26b-a4b
# Cloud curators, used only when CURATOR names them (a key alone never turns them on); when one
# answers nothing (no credit, quota, network) the local model answers instead.
# CURATOR=gemini: https://aistudio.google.com/apikey -> "Create API key" in a NEW project. Free only on
# a project without billing; on a paid or prepaid project every picture costs.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemma-4-26b-a4b-it  (best first; the next when one is busy)
# GEMINI_THINKING=medium
# CURATOR=claude (paid): https://platform.claude.com/settings/keys -> "Create Key"
ANTHROPIC_API_KEY=
# Taste from Are.na (optional): the public images that these people collect weigh the choice of door
# pictures and the order of "Per te" (a weight, never a filter). Profile slugs, comma separated, as in
# are.na/<slug>; a read token from https://www.are.na/settings/personal-access-tokens raises the limits.
# ARENA_TASTE=
ARENA_TOKEN=
