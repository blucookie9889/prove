# Copy to .env (git-ignored) and paste your free keys; restart the backend afterwards.
# Unsplash: https://unsplash.com/oauth/applications -> New Application -> "Access Key"
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/ -> "Get started" / "Your API key"
PEXELS_API_KEY=
# Anthropic (paid, the curator that looks at each picture and opens doors from it):
# https://platform.claude.com/settings/keys -> "Create Key". Without it the flow uses Wikimedia concepts only.
ANTHROPIC_API_KEY=
